# -----------------------------------------------------------------------------
# Batch Flow Engine Environment Configuration
# -----------------------------------------------------------------------------

# Application Server
SERVER_PORT=8080

# PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/batch_flow_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword
DB_POOL_MAX_SIZE=25
DB_POOL_MIN_IDLE=10
JPA_BATCH_SIZE=500
JDBC_BATCH_SIZE=1000

# RabbitMQ Configuration
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=rabbitmq
SPRING_RABBITMQ_PASSWORD=rabbitmqpassword

# Worker & Queue Tuning
WORKER_CONCURRENCY=8
WORKER_MAX_CONCURRENCY=20
WORKER_PREFETCH=25
BATCH_DEFAULT_CHUNK_SIZE=200

# Resilience & Exponential Backoff Retry Policy
BATCH_RETRY_MAX_ATTEMPTS=3
BATCH_RETRY_INITIAL_INTERVAL=1000
BATCH_RETRY_MULTIPLIER=2.0
BATCH_RETRY_MAX_INTERVAL=10000
